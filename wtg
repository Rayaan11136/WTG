function buildCar(color, isSuv){
  const g = new THREE.Group();
  const L = isSuv ? 4.9 : 4.4, W = isSuv ? 2.0 : 1.86, lift = isSuv ? .16 : 0;
  const paint = new THREE.MeshStandardMaterial({color, roughness:.28, metalness:.72, envMapIntensity:1.5});

  const b = new THREE.Shape();
  b.moveTo(-L/2, .28); b.lineTo(-L/2+.1, .74); b.lineTo(-L*0.3, .82);
  b.lineTo(L*0.14, .86); b.lineTo(L*0.42, .78); b.lineTo(L/2-.06, .66);
  b.lineTo(L/2, .42); b.lineTo(L/2-.12, .28); b.closePath();
  const bodyGeo = new THREE.ExtrudeGeometry(b, {depth:W, bevelEnabled:true, bevelSize:.06, bevelThickness:.06, bevelSegments:2});
  bodyGeo.rotateY(Math.PI/2); bodyGeo.translate(W/2,0,0);
  const body = new THREE.Mesh(bodyGeo, paint);
  body.position.y = .34 + lift; body.castShadow = true; g.add(body);

  const c = new THREE.Shape();
  c.moveTo(-L*0.28, .84); c.lineTo(-L*0.34, 1.12); c.lineTo(L*0.02, 1.2);
  c.lineTo(L*0.2, 1.1); c.lineTo(L*0.24, .84); c.closePath();
  const cabGeo = new THREE.ExtrudeGeometry(c, {depth:W-.16, bevelEnabled:false});
  cabGeo.rotateY(Math.PI/2); cabGeo.translate((W-.16)/2,0,0);
  const cab = new THREE.Mesh(cabGeo, M.glass);
  cab.position.y = .34 + lift; cab.castShadow = true; g.add(cab);

  const roof = new THREE.Mesh(new THREE.BoxGeometry(W-.22, .07, L*0.3), paint);
  roof.position.set(0, 1.5 + lift, -L*0.06); g.add(roof);

  const tyre = new THREE.MeshStandardMaterial({color:0x14161a, roughness:.95});
  for(const wx of [-W/2+.06, W/2-.06]){
    for(const wz of [-L*0.31, L*0.31]){
      const t = new THREE.Mesh(new THREE.CylinderGeometry(.36+lift,.36+lift,.26,18), tyre);
      t.rotation.z = Math.PI/2; t.position.set(wx, .36+lift, wz); t.castShadow=true; g.add(t);
      const r = new THREE.Mesh(new THREE.CylinderGeometry(.21,.21,.28,10), M.steel);
      r.rotation.z = Math.PI/2; r.position.set(wx, .36+lift, wz); g.add(r);
      const arch = new THREE.Mesh(new THREE.TorusGeometry(.42+lift,.05,6,14,Math.PI), M.trim);
      arch.position.set(wx, .38+lift, wz); arch.rotation.y=Math.PI/2; g.add(arch);
    }
  }

  const hl = new THREE.Mesh(new THREE.BoxGeometry(W-.5,.14,.1), M.headlamp.clone());
  hl.position.set(0, .72+lift, -L/2+.02); g.add(hl);
  const tl = new THREE.Mesh(new THREE.BoxGeometry(W-.42,.11,.1), M.taillamp.clone());
  tl.position.set(0, .78+lift, L/2-.02); g.add(tl);
  g.userData.headlamp = hl.material;
  g.userData.taillamp = tl.material;
  return g;
}

