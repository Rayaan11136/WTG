const inspectables = [];
const AssetRegistry = {};

function registerDigitalAsset(mesh, assetConfig){
  AssetRegistry[assetConfig.id] = assetConfig;
  mesh.userData.assetId = assetConfig.id;
  inspectables.push(mesh);
  return mesh;
}

function addShadow(m){ m.castShadow = true; m.receiveShadow = true; return m; }

/* -- terrain -- */
