/* Real-Time Detailed Asset Inspector */
function renderAssetInspector(assetId){
  const asset = AssetRegistry[assetId];
  if(!asset) return;
  currentInspectedAssetId = assetId;

  const live = asset.getLive ? asset.getLive(S) : {};

  $('#i-title').textContent = asset.name;
  $('#i-id').textContent = asset.id + ' · ' + asset.type;
  $('#i-desc').textContent = asset.desc;
  $('#i-loc').textContent = asset.location;
  $('#i-cap').textContent = asset.rating;
  $('#i-load').textContent = live.load || '—';
  $('#i-gen').textContent = live.gen || '0 kW';
  $('#i-pf').textContent = live.pf || S.pf.toFixed(2);
  $('#i-flex').textContent = live.flex || '—';
  $('#i-state').innerHTML = `<span class="i-status-dot" style="background:${live.state && live.state.includes('CRITICAL') ? '#ff5a52' : live.state && live.state.includes('STRESSED') ? '#ffb020' : '#3ddc8a'}"></span>` + (live.state || 'Normal');
  $('#i-health').textContent = live.health || '99 / 100';

  $('#inspect').style.display = 'block';
}

const ray = new THREE.Raycaster(), ptr = new THREE.Vector2();
const hint = $('#hint');
function pickAt(cx,cy){
  ptr.x = (cx/innerWidth)*2-1; ptr.y = -(cy/innerHeight)*2+1;
  ray.setFromCamera(ptr, camera);
  return ray.intersectObjects(inspectables, true)[0];
}

renderer.domElement.addEventListener('pointermove', e=>{
  const hit = pickAt(e.clientX, e.clientY);
  if(hit && hit.object.userData.assetId){
    const asset = AssetRegistry[hit.object.userData.assetId];
    hint.style.display='block';
    hint.style.left = Math.min(e.clientX+14, innerWidth-240)+'px';
    hint.style.top = (e.clientY+16)+'px';
    hint.textContent = 'Inspect ' + (asset ? asset.name : 'Component');
    renderer.domElement.style.cursor='pointer';
  } else {
    hint.style.display='none';
    renderer.domElement.style.cursor='grab';
  }
});

renderer.domElement.addEventListener('click', e=>{
  const hit = pickAt(e.clientX, e.clientY);
  if(!hit || !hit.object.userData.assetId) return;
  renderAssetInspector(hit.object.userData.assetId);
  Audio_.beep(700,.08);
});

$('#inspect-x').addEventListener('click', ()=>{ 
  $('#inspect').style.display='none'; 
  currentInspectedAssetId = null;
});

/* ============================================================
   14. GAUGES & TRACES
   ============================================================ */
const el = {
  load:$('#m-load'), loadSub:$('#m-load-sub'), solar:$('#m-solar'), irr:$('#m-irr'),
  temp:$('#m-temp'), freq:$('#m-freq'), volt:$('#m-volt'), pf:$('#m-pf'),
  soc:$('#m-soc'), bat:$('#m-bat'), ev:$('#m-ev'), evSub:$('#m-ev-sub'),
  hdr:$('#m-hdr'), pill:$('#m-pill')
};
const COL = {ok:'#3ddc8a', warn:'#ffb020', crit:'#ff5a52', cy:'#4fd3ff', vi:'#b388ff'};

function paintGauges(){
  el.load.textContent = S.load.toFixed(1)+' %';
  el.load.style.color = S.load>=90?COL.crit : S.load>=75?COL.warn : COL.ok;
  el.loadSub.textContent = Math.round(S.load*2)+' / 200 kVA';
  el.solar.textContent = Math.round(S.solar)+' kW';
  el.solar.style.color = S.solar<100?COL.warn:'#ffd27a';
  el.irr.textContent = Math.round(S.irr)+' W/m² · wind '+Math.round(S.wind)+' kW';
  el.temp.textContent = S.temp.toFixed(1)+' °C';
  el.temp.style.color = S.temp>=95?COL.crit : S.temp>=78?COL.warn : COL.cy;
  el.freq.textContent = S.freq.toFixed(2)+' Hz';
  el.freq.style.color = S.freq<1?COL.crit : Math.abs(S.freq-50)>0.2?COL.crit : Math.abs(S.freq-50)>0.08?COL.warn : COL.ok;
  el.volt.textContent = S.volt.toFixed(1)+' V';
  el.volt.style.color = S.volt<10?COL.crit : S.volt<216?COL.crit : S.volt<223?COL.warn : COL.cy;
  el.pf.textContent = S.pf.toFixed(2);
  el.pf.style.color = S.pf<.9?COL.warn:COL.vi;
  el.soc.textContent = Math.round(S.soc)+' %';
  el.soc.style.color = S.soc<20?COL.crit : S.soc<45?COL.warn : COL.ok;
  el.bat.textContent = (S.bat>=0?'+':'')+Math.round(S.bat)+' kW '+(S.bat>=0?'charging':'discharging');
  el.ev.textContent = Math.round(S.ev)+' kW';
  el.ev.style.color = S.ev>200?COL.crit : S.ev>90?COL.warn : COL.vi;
  el.evSub.textContent = Math.round(S.evCars)+' vehicles connected';
  el.hdr.textContent = condition.headline;
  el.pill.textContent = condition.pill;
  const pc = condition.tone==='crit'?COL.crit : condition.tone==='warn'?COL.warn : condition.tone==='ai'?COL.vi : COL.ok;
  el.pill.style.color = pc;
  const r = parseInt(pc.slice(1,3),16), gg = parseInt(pc.slice(3,5),16), bb = parseInt(pc.slice(5,7),16);
  el.pill.style.background = 'rgba('+r+','+gg+','+bb+',.16)';

  // Keep inspector updated with live numbers if open
  if(currentInspectedAssetId && $('#inspect').style.display !== 'none'){
    const asset = AssetRegistry[currentInspectedAssetId];
    if(asset && asset.getLive){
      const live = asset.getLive(S);
      $('#i-load').textContent = live.load || '—';
      $('#i-gen').textContent = live.gen || '0 kW';
      $('#i-pf').textContent = live.pf || S.pf.toFixed(2);
      $('#i-flex').textContent = live.flex || '—';
      $('#i-state').innerHTML = `<span class="i-status-dot" style="background:${live.state && live.state.includes('CRITICAL') ? '#ff5a52' : live.state && live.state.includes('STRESSED') ? '#ffb020' : '#3ddc8a'}"></span>` + (live.state || 'Normal');
      $('#i-health').textContent = live.health || '99 / 100';
    }
  }
}

function traceCtx(id){
  const c = $(id);
  const dpr = Math.min(devicePixelRatio,2);
  c.width = c.clientWidth*dpr; c.height = c.clientHeight*dpr;
  const x = c.getContext('2d'); x.scale(dpr,dpr);
  return {c,x,w:c.clientWidth,h:c.clientHeight,dpr};
}
let histLoad = new Array(90).fill(58), histFreq = new Array(90).fill(50);
function drawTraces(){
  let g = traceCtx('#trace-load');
  g.x.clearRect(0,0,g.w,g.h);
  g.x.strokeStyle='rgba(255,255,255,.06)';
  for(let i=1;i<4;i++){ g.x.beginPath(); g.x.moveTo(0,g.h*i/4); g.x.lineTo(g.w,g.h*i/4); g.x.stroke(); }
  g.x.fillStyle='rgba(255,90,82,.09)'; g.x.fillRect(0,0,g.w,g.h*.12);
  const col = S.load>=90?COL.crit:S.load>=75?COL.warn:COL.cy;
  g.x.beginPath();
  histLoad.forEach((v,i)=>{
    const px=i/(histLoad.length-1)*g.w, py=g.h-(v/110)*g.h;
    i?g.x.lineTo(px,py):g.x.moveTo(px,py);
  });
  g.x.strokeStyle=col; g.x.lineWidth=1.8; g.x.stroke();
  g.x.lineTo(g.w,g.h); g.x.lineTo(0,g.h); g.x.closePath();
  g.x.fillStyle = col+'22'; g.x.fill();

  g = traceCtx('#trace-freq');
  g.x.clearRect(0,0,g.w,g.h);
  g.x.strokeStyle='rgba(255,255,255,.06)';
  g.x.beginPath(); g.x.moveTo(0,g.h/2); g.x.lineTo(g.w,g.h/2); g.x.stroke();
  g.x.beginPath();
  histFreq.forEach((v,i)=>{
    const px=i/(histFreq.length-1)*g.w;
    const py=g.h/2 - clamp((v-50)/0.8,-1,1)*(g.h/2-4);
    i?g.x.lineTo(px,py):g.x.moveTo(px,py);
  });
  const fcol = Math.abs(S.freq-50)>0.2?COL.crit:Math.abs(S.freq-50)>0.08?COL.warn:COL.ok;
  g.x.strokeStyle=fcol; g.x.lineWidth=1.8; g.x.stroke();

  $('#trace-load-v').textContent = S.load.toFixed(1)+'%';
  $('#trace-freq-v').textContent = S.freq.toFixed(2)+' Hz';
}
setInterval(()=>{
  histLoad.push(clamp(S.load + rnd(-1.2,1.2),0,110)); histLoad.shift();
  histFreq.push(S.freq>1 ? S.freq + rnd(-.015,.015) : 49.2); histFreq.shift();
  drawTraces();
}, 420);

/* ============================================================
   15. ANIMATION LOOP
   ============================================================ */
const clock = new THREE.Clock();
let lampSmooth = 0;

function updateSim(dt){
  const rate = clamp(dt*1.4, 0, .35);
  for(const k in T){ if(typeof S[k]==='number') S[k] = lerp(S[k], T[k], rate); }
  if(scenarioKey==='normal' && !Crisis.running){
    S.freq = 50 + Math.sin(clock.elapsedTime*1.7)*0.018 + Math.sin(clock.elapsedTime*.53)*.01;
    S.volt = 230.6 + Math.cos(clock.elapsedTime*1.1)*.7;
  }
  Audio_.hum(clamp((S.load-40)/70, 0, 1) * (S.volt>10?1:0));
}

function animate(){
  requestAnimationFrame(animate);
  const dt = Math.min(clock.getDelta(), .05);
  const t = clock.elapsedTime;

  Crisis.tick(dt);
  updateSim(dt);
  paintGauges();
  updateVisualReactions();

  if(camTarget){
    camera.position.lerp(camTarget.p, 1-Math.pow(.001,dt));
    controls.target.lerp(camTarget.t, 1-Math.pow(.001,dt));
    if(camera.position.distanceTo(camTarget.p)<.4) camTarget=null;
  }
  controls.update();

  let flick = 1;
  if(window.__flicker>0){
    window.__flicker -= dt;
    flick = Math.random()>.35 ? 1 : rnd(.05,.4);
  }
  lampSmooth = lerp(lampSmooth, lampLevel, dt*2.2);
  const homeLit = powered.homes ? lampSmooth*flick : 0;
  const industryLit = powered.industry ? Math.max(lampSmooth,0.25)*flick : 0;
  const evLit = powered.ev ? Math.max(lampSmooth,0.2)*flick : 0;
  const streetLit = (powered.homes||powered.industry) ? lampSmooth*flick : 0;

  M.homeWindow.emissiveIntensity = homeLit*1.5;
  M.worksWindow.emissiveIntensity = industryLit*1.1;
  M.lamp.emissiveIntensity = streetLit*2.2;
  streetLamps.forEach(l=>{
    if(l.cone) l.cone.material.opacity = streetLit*.12;
    if(l.pool) l.pool.material.opacity = streetLit*.5;
  });
  M.screen.emissiveIntensity = powered.ev ? 1.4 : 0;
  evChargers.forEach((c,i)=>{
    c.screen.emissiveIntensity = powered.ev ? (1.2 + Math.sin(t*2+i)*.2) : 0;
    const busy = S.ev > 120;
    c.ring.emissive.setHex(!powered.ev ? 0x000000 : busy ? 0xff4b42 : 0x2bff92);
    c.ring.emissiveIntensity = powered.ev ? (busy ? 1.6+Math.sin(t*9)*1.0 : 2.0) : 0;
  });

  const carLit = lampSmooth>.3 ? 1 : 0;
  traffic.forEach(v=>{
    if(v.kind==='ring'){
      v.ang += v.speed*dt;
      const dx = -Math.sin(v.ang), dz = Math.cos(v.ang);
      v.car.position.set(Math.cos(v.ang)*v.radius, 0, Math.sin(v.ang)*v.radius);
      v.car.rotation.y = Math.atan2(-dx, -dz);
    } else {
      v.r += v.dir*v.speed*dt;
      if(v.r > 98) v.r = 26;
      if(v.r < 26) v.r = 98;
      const dx = v.u.x*v.dir, dz = v.u.z*v.dir;
      v.car.position.set(v.u.x*v.r + dz*3.2, 0, v.u.z*v.r - dx*3.2);
      v.car.rotation.y = Math.atan2(-dx, -dz);
    }
    if(v.car.userData.headlamp) v.car.userData.headlamp.emissiveIntensity = carLit*2.2;
    if(v.car.userData.taillamp) v.car.userData.taillamp.emissiveIntensity = .5 + carLit*1.2;
  });

  evCars.forEach((c,i)=>{
    if(!c.userData.port) return;
    const busy = powered.ev && S.ev > 5;
    c.userData.port.emissive.setHex(!powered.ev ? 0x000000 : S.ev>200 ? 0xffb020 : 0x2bff92);
    c.userData.port.emissiveIntensity = busy ? 1.6 + Math.sin(t*2.6 + i)*1.0 : 0;
    if(c.userData.taillamp) c.userData.taillamp.emissiveIntensity = busy ? .5 : .15;
  });

  const hot = clamp((S.temp-55)/45, 0, 1);
  transformerParts.fans.forEach((f,i)=>{
    const dead = f.userData.dead;
    f.rotation.z += (dead?0:(2 + hot*16))*dt;
  });
  M.paintedGrey.emissive = M.paintedGrey.emissive || new THREE.Color();
  M.paintedGrey.emissive.setRGB(hot*0.22, hot*0.045, 0);
  transformerParts.indicators.forEach((led,i)=>{
    const crit = S.temp>=90 || S.volt<210 || !powered.homes;
    led.material.emissive.setHex(crit ? 0xff3b30 : S.temp>=75 ? 0xffb020 : 0x2bff92);
    led.material.emissiveIntensity = crit ? (Math.sin(t*9+i)>0?3.4:0.25) : 2.0;
  });
  faultLight.intensity = hot>0.55 ? (0.6+Math.sin(t*7)*0.4)*14*hot : 0;
  arcFlash.intensity = Math.max(0, arcFlash.intensity - dt*55);

  homeBatteryLeds.forEach((led,i)=>{
    if(!powered.homes){ led.material.emissiveIntensity = 0; return; }
    led.material.emissive.setHex(S.soc<20?0xff3b30 : S.soc<45?0xffb020 : 0x2bff92);
    led.material.emissiveIntensity = 1.8 + Math.sin(t*1.6+i)*.3;
  });

  worksFans.forEach((f,i)=> f.rotation.y += (powered.industry ? 3.4 + S.load*0.02 : 0.2)*dt);
  if(industryGroup.userData.beacon){
    const b = industryGroup.userData.beacon.material;
    b.emissiveIntensity = (Math.sin(t*4)>0.4?3.2:0.2);
  }
  stackSmoke.forEach((sm,i)=>{
    const s = sm.s;
    s.position.y += (powered.industry? 2.2 : .5)*dt;
    s.position.x = -16 + Math.sin(t*.4 + sm.seed)*(s.position.y-20)*0.12;
    s.position.z = -8 + Math.cos(t*.3 + sm.seed)*(s.position.y-20)*0.09;
    s.scale.setScalar(2.4 + (s.position.y-20)*0.22);
    s.material.opacity = clamp(.26 - (s.position.y-20)*0.006, 0, .3) * (powered.industry?1:.4);
    if(s.position.y > 54){ s.position.y = 20; }
  });
  if(windTurbine) windTurbine.userData.rotor.rotation.z += (0.6 + S.wind*0.012)*dt;

  const irr = clamp(S.irr/940, .05, 1);
  M.solar.emissive = M.solar.emissive || new THREE.Color();
  M.solar.emissive.setRGB(0.02*irr, 0.06*irr, 0.14*irr);

  const pulse = .78 + Math.sin(t*5)*.18;
  function advanceFlow(f, energised){
    const arr = f.geo.attributes.position.array;
    for(let i=0;i<f.prog.length;i++){
      f.prog[i] += f.speed*dt;
      if(f.prog[i]>1) f.prog[i] -= 1;
      const p = f.curve.getPointAt(clamp(f.prog[i],0,.9999));
      arr[i*3]=p.x; arr[i*3+1]=p.y; arr[i*3+2]=p.z;
    }
    f.geo.attributes.position.needsUpdate = true;
    f.mat.opacity = energised ? pulse : 0;
    f.haloMat.opacity = energised ? .55*pulse : 0;
    f.tubeMat.opacity = energised ? .34 + Math.sin(t*3)*.08 : 0;
  }
  flows.forEach(f=>advanceFlow(f, true));

  const hubCol = condition.tone==='crit' ? 0xff4b42 : condition.tone==='warn' ? 0xffb020 :
                 condition.tone==='ai' ? 0xb388ff : 0x4fd3ff;
  const live = powered.homes || powered.industry || powered.ev;
  hubRing.speed = live ? (.08 + S.load*0.0028) : 0;
  hubRing.haloMat.color.setHex(hubCol);
  hubRing.tubeMat.color.setHex(hubCol);
  advanceFlow(hubRing, live);
  hubParts.glowRings.forEach((r,i)=>{
    r.material.color.setHex(hubCol);
    r.material.opacity = live ? (.45 + Math.sin(t*3 + i*1.6)*.3) : .05;
    r.scale.setScalar(1 + Math.sin(t*1.4 + i)*0.012);
  });
  if(hubParts.halo){
    hubParts.halo.material.color.setHex(hubCol);
    hubParts.halo.material.opacity = live ? (.2 + Math.sin(t*2.2)*.08) : .03;
  }
  if(hubParts.bus) hubParts.bus.material.emissiveIntensity = 0;
  if(hubParts.beacon){
    hubParts.beacon.material.emissive.setHex(condition.tone==='crit' ? 0xff3b30 : 0xff6a3d);
    hubParts.beacon.material.emissiveIntensity = (Math.sin(t*3.4)>0.3 ? 3.4 : 0.15);
  }
  hubParts.screens.forEach((m,i)=>{
    m.emissive.setHex(hubCol);
    m.emissiveIntensity = live ? 1.4 + Math.sin(t*2.4+i)*.35 : 0;
  });

  const sp = window.__sparks;
  let anyAlive = false;
  for(let i=0;i<sparkPool.length;i++){
    const s = sparkPool[i];
    if(s.life<=0) continue;
    anyAlive = true;
    s.life -= dt;
    s.v.y -= 16*dt;
    sp.pos[i*3] += s.v.x*dt; sp.pos[i*3+1] += s.v.y*dt; sp.pos[i*3+2] += s.v.z*dt;
    if(sp.pos[i*3+1] < 0.2){ s.life = 0; sp.pos[i*3+1] = -50; }
  }
  if(anyAlive){ sp.geo.attributes.position.needsUpdate = true; sp.mat.opacity = lerp(sp.mat.opacity, .95, dt*6); }
  else sp.mat.opacity = lerp(sp.mat.opacity, 0, dt*4);

  faultSmoke.forEach((f,i)=>{
    const target = faultSmokeOn ? .5 : 0;
    f.s.material.opacity = lerp(f.s.material.opacity, target*clamp(1-f.t,0,1), dt*1.2);
    if(faultSmokeOn){
      f.t += dt*0.16;
      if(f.t>1){ f.t=0; f.s.position.set(24+rnd(-1,1), 6, 26+rnd(-1,1)); f.s.scale.setScalar(2.5); }
      f.s.position.y += 2.4*dt;
      f.s.position.x += Math.sin(t+i)*0.5*dt;
      f.s.scale.setScalar(2.5 + f.t*7);
    }
  });

  stars.material.opacity = PRESETS[timeOfDay].stars * (0.75 + Math.sin(t*0.8)*0.15);

  if(composer) composer.render(); else renderer.render(scene, camera);
}

