<script>
(function(){
"use strict";

/* ============================================================
   0. SMALL HELPERS
   ============================================================ */
const $ = s => document.querySelector(s);
const $$ = s => Array.from(document.querySelectorAll(s));
const clamp = (v,a,b) => Math.min(b,Math.max(a,v));
const lerp = (a,b,t) => a + (b-a)*t;
const rnd = (a,b) => a + Math.random()*(b-a);
const pick = a => a[Math.floor(Math.random()*a.length)];

function canvas2d(w,h){
  const c = document.createElement('canvas');
  c.width = w; c.height = h;
  return [c, c.getContext('2d')];
}

/* ============================================================
   1. AUDIO — synthesised control-room feedback
   ============================================================ */
const Audio_ = {
  ctx:null, on:true, humGain:null,
  init(){
    if(this.ctx) return;
    try{ this.ctx = new (window.AudioContext||window.webkitAudioContext)(); }catch(e){ return; }
    const osc = this.ctx.createOscillator(), osc2 = this.ctx.createOscillator();
    const g = this.ctx.createGain(), f = this.ctx.createBiquadFilter();
    osc.type='sine'; osc.frequency.value=50;
    osc2.type='triangle'; osc2.frequency.value=100;
    f.type='lowpass'; f.frequency.value=260;
    g.gain.value=0.0;
    osc.connect(f); osc2.connect(f); f.connect(g); g.connect(this.ctx.destination);
    osc.start(); osc2.start();
    this.humGain = g;
  },
  resume(){ this.init(); if(this.ctx && this.ctx.state==='suspended') this.ctx.resume(); },
  hum(level){ if(!this.humGain||!this.ctx) return; this.humGain.gain.setTargetAtTime(this.on?level*0.05:0, this.ctx.currentTime, .4); },
  beep(freq=620, dur=.1, type='sine', vol=.05){
    if(!this.on) return; this.resume(); if(!this.ctx) return;
    const o=this.ctx.createOscillator(), g=this.ctx.createGain();
    o.type=type; o.frequency.setValueAtTime(freq,this.ctx.currentTime);
    g.gain.setValueAtTime(vol,this.ctx.currentTime);
    g.gain.exponentialRampToValueAtTime(.0001,this.ctx.currentTime+dur);
    o.connect(g); g.connect(this.ctx.destination); o.start(); o.stop(this.ctx.currentTime+dur);
  },
  alarm(){ this.beep(740,.16,'sawtooth',.045); setTimeout(()=>this.beep(560,.2,'sawtooth',.045),150); },
  trip(){ this.beep(180,.5,'square',.05); setTimeout(()=>this.beep(120,.7,'square',.04),120); },
  ok(){ this.beep(720,.09); setTimeout(()=>this.beep(980,.16),100); }
};

/* ============================================================
   2. PROCEDURAL TEXTURES
   ============================================================ */
const Tex = {
  _fin(c, rx, ry, srgb){
    const t = new THREE.CanvasTexture(c);
    t.wrapS = t.wrapT = THREE.RepeatWrapping;
    t.repeat.set(rx||1, ry||1);
    t.anisotropy = 8;
    if(srgb !== false) t.encoding = THREE.sRGBEncoding;
    return t;
  },
  grain(ctx,w,h,n,lo,hi,alpha){
    for(let i=0;i<n;i++){
      const s = Math.floor(rnd(lo,hi));
      ctx.fillStyle = `rgba(${s},${s+3},${s+7},${alpha})`;
      ctx.fillRect(Math.random()*w, Math.random()*h, rnd(1,3), rnd(1,3));
    }
  },
  asphalt(lanes){
    const [c,x] = canvas2d(1024,1024);
    x.fillStyle='#22262c'; x.fillRect(0,0,1024,1024);
    this.grain(x,1024,1024,60000,26,74,.3);
    for(let i=0;i<7;i++){
      x.fillStyle=`rgba(${rnd(18,40)|0},${rnd(18,40)|0},${rnd(20,44)|0},.5)`;
      x.fillRect(rnd(0,900), rnd(0,900), rnd(60,180), rnd(50,160));
    }
    for(let i=0;i<40;i++){
      x.fillStyle='rgba(0,0,0,.12)';
      x.fillRect(rnd(0,1024), rnd(0,1024), rnd(2,7), rnd(40,260));
    }
    if(lanes){
      x.fillStyle='rgba(232,238,247,.78)';
      x.fillRect(58,0,10,1024); x.fillRect(956,0,10,1024);
      x.fillStyle='rgba(255,208,110,.72)';
      for(let y=0;y<1024;y+=110){ x.fillRect(500,y,8,62); x.fillRect(518,y,8,62); }
    }
    return this._fin(c);
  },
  grass(){
    const [c,x] = canvas2d(1024,1024);
    const g = x.createLinearGradient(0,0,1024,1024);
    g.addColorStop(0,'#3a5c30'); g.addColorStop(.5,'#2f4f28'); g.addColorStop(1,'#37582c');
    x.fillStyle=g; x.fillRect(0,0,1024,1024);
    for(let i=0;i<260;i++){
      x.fillStyle=`rgba(${rnd(40,92)|0},${rnd(70,130)|0},${rnd(36,72)|0},.3)`;
      x.beginPath(); x.ellipse(rnd(0,1024),rnd(0,1024),rnd(30,150),rnd(24,110),rnd(0,3),0,7); x.fill();
    }
    for(let i=0;i<50000;i++){
      const s=rnd(.3,1);
      x.fillStyle=`rgba(${(58*s)|0},${(96*s)|0},${(46*s)|0},.35)`;
      x.fillRect(Math.random()*1024, Math.random()*1024, 2, 3);
    }
    for(let i=0;i<12;i++){
      x.fillStyle='rgba(112,94,62,.18)';
      x.beginPath(); x.ellipse(rnd(0,1024),rnd(0,1024),rnd(40,120),rnd(14,40),rnd(0,3),0,7); x.fill();
    }
    return this._fin(c,26,26);
  },
  concrete(){
    const [c,x] = canvas2d(512,512);
    x.fillStyle='#8c8f93'; x.fillRect(0,0,512,512);
    this.grain(x,512,512,30000,110,165,.22);
    x.strokeStyle='rgba(50,52,56,.5)'; x.lineWidth=2;
    for(let i=0;i<=512;i+=128){
      x.beginPath(); x.moveTo(i,0); x.lineTo(i,512); x.stroke();
      x.beginPath(); x.moveTo(0,i); x.lineTo(512,i); x.stroke();
    }
    for(let i=0;i<18;i++){
      x.strokeStyle='rgba(60,62,66,.3)'; x.lineWidth=1;
      x.beginPath(); x.moveTo(rnd(0,512),rnd(0,512));
      x.lineTo(rnd(0,512),rnd(0,512)); x.stroke();
    }
    return this._fin(c,3,3);
  },
  gravel(){
    const [c,x] = canvas2d(512,512);
    x.fillStyle='#6b6f75'; x.fillRect(0,0,512,512);
    for(let i=0;i<26000;i++){
      const s=rnd(80,190)|0;
      x.fillStyle=`rgba(${s},${s-4},${s-10},.55)`;
      x.beginPath(); x.arc(rnd(0,512),rnd(0,512),rnd(1.2,3.4),0,7); x.fill();
    }
    return this._fin(c,10,10);
  },
  roofTile(dark){
    const [c,x] = canvas2d(512,512);
    x.fillStyle = dark ? '#3a4150' : '#7c3b2e'; x.fillRect(0,0,512,512);
    for(let y=0;y<512;y+=26){
      for(let px=0;px<512;px+=44){
        const off = (y/26)%2 ? 22 : 0;
        const v = rnd(-16,16);
        x.fillStyle = dark ? `rgb(${58+v},${66+v},${80+v})` : `rgb(${132+v},${64+v},${48+v})`;
        x.fillRect(px+off+1, y+1, 42, 24);
        x.fillStyle='rgba(0,0,0,.25)';
        x.fillRect(px+off+1, y+21, 42, 4);
      }
    }
    return this._fin(c,5,5);
  },
  stucco(hex){
    const [c,x] = canvas2d(512,512);
    x.fillStyle=hex; x.fillRect(0,0,512,512);
    for(let i=0;i<40000;i++){
      x.fillStyle=`rgba(255,255,255,${rnd(.02,.09)})`;
      x.fillRect(Math.random()*512,Math.random()*512,2,2);
    }
    for(let i=0;i<20000;i++){
      x.fillStyle=`rgba(0,0,0,${rnd(.02,.07)})`;
      x.fillRect(Math.random()*512,Math.random()*512,2,2);
    }
    const g = x.createLinearGradient(0,380,0,512);
    g.addColorStop(0,'rgba(0,0,0,0)'); g.addColorStop(1,'rgba(30,26,20,.28)');
    x.fillStyle=g; x.fillRect(0,380,512,132);
    return this._fin(c,1,1);
  },
  brick(){
    const [c,x] = canvas2d(512,512);
    x.fillStyle='#6f4034'; x.fillRect(0,0,512,512);
    for(let y=0;y<512;y+=20){
      for(let px=0;px<512;px+=44){
        const off=(y/20)%2?22:0, v=rnd(-20,18);
        x.fillStyle=`rgb(${136+v},${68+v},${52+v})`;
        x.fillRect(px+off+2,y+2,40,16);
      }
    }
    return this._fin(c,4,4);
  },
  corrugated(){
    const [c,x] = canvas2d(512,512);
    for(let px=0;px<512;px+=16){
      const g=x.createLinearGradient(px,0,px+16,0);
      g.addColorStop(0,'#4b5563'); g.addColorStop(.45,'#9aa5b4'); g.addColorStop(.55,'#8b95a4'); g.addColorStop(1,'#414b58');
      x.fillStyle=g; x.fillRect(px,0,16,512);
    }
    for(let i=0;i<30;i++){
      x.fillStyle=`rgba(${rnd(80,120)|0},${rnd(50,70)|0},${rnd(30,44)|0},${rnd(.05,.16)})`;
      x.fillRect(rnd(0,512), rnd(300,512), rnd(10,60), rnd(10,120));
    }
    x.fillStyle='rgba(20,24,30,.5)'; x.fillRect(0,0,512,10); x.fillRect(0,502,512,10);
    return this._fin(c,6,3);
  },
  solar(){
    const [c,x] = canvas2d(512,512);
    x.fillStyle='#0f1c33'; x.fillRect(0,0,512,512);
    for(let cy=0;cy<512;cy+=128){
      for(let cx=0;cx<512;cx+=128){
        const g=x.createLinearGradient(cx,cy,cx+128,cy+128);
        g.addColorStop(0,'#16294d'); g.addColorStop(.5,'#0d1b36'); g.addColorStop(1,'#1b3157');
        x.fillStyle=g; x.fillRect(cx+3,cy+3,122,122);
        x.strokeStyle='rgba(206,220,240,.30)'; x.lineWidth=1.4;
        for(let i=16;i<128;i+=16){ x.beginPath(); x.moveTo(cx+i,cy+3); x.lineTo(cx+i,cy+125); x.stroke(); }
        x.strokeStyle='rgba(226,236,250,.6)'; x.lineWidth=3.5;
        x.beginPath(); x.moveTo(cx+3,cy+42); x.lineTo(cx+125,cy+42); x.stroke();
        x.beginPath(); x.moveTo(cx+3,cy+86); x.lineTo(cx+125,cy+86); x.stroke();
      }
    }
    x.strokeStyle='#aeb7c4'; x.lineWidth=7; x.strokeRect(3,3,506,506);
    return this._fin(c);
  },
  hazard(){
    const [c,x] = canvas2d(256,64);
    x.fillStyle='#e8a41c'; x.fillRect(0,0,256,64);
    x.fillStyle='#14181f';
    for(let px=-64;px<256;px+=42){
      x.beginPath(); x.moveTo(px,0); x.lineTo(px+21,0); x.lineTo(px+53,64); x.lineTo(px+32,64); x.closePath(); x.fill();
    }
    x.fillStyle='rgba(0,0,0,.18)'; x.fillRect(0,54,256,10);
    return this._fin(c,10,1);
  },
  glow(){
    const [c,x] = canvas2d(128,128);
    const g = x.createRadialGradient(64,64,0,64,64,64);
    g.addColorStop(0,'rgba(255,255,255,1)');
    g.addColorStop(.25,'rgba(255,255,255,.65)');
    g.addColorStop(.6,'rgba(255,255,255,.14)');
    g.addColorStop(1,'rgba(255,255,255,0)');
    x.fillStyle=g; x.fillRect(0,0,128,128);
    const t = new THREE.CanvasTexture(c); t.encoding = THREE.sRGBEncoding; return t;
  },
  smoke(){
    const [c,x] = canvas2d(128,128);
    const g = x.createRadialGradient(64,64,4,64,64,62);
    g.addColorStop(0,'rgba(220,224,230,.85)');
    g.addColorStop(.5,'rgba(190,196,206,.32)');
    g.addColorStop(1,'rgba(170,176,186,0)');
    x.fillStyle=g; x.fillRect(0,0,128,128);
    const t = new THREE.CanvasTexture(c); t.encoding = THREE.sRGBEncoding; return t;
  },
  sky(top, horizon, ground, sunColor, sunY){
    const [c,x] = canvas2d(1024,512);
    const g = x.createLinearGradient(0,0,0,512);
    g.addColorStop(0, top);
    g.addColorStop(.42, horizon);
    g.addColorStop(.5, horizon);
    g.addColorStop(.52, ground);
    g.addColorStop(1, ground);
    x.fillStyle=g; x.fillRect(0,0,1024,512);
    const sg = x.createRadialGradient(330, sunY, 0, 330, sunY, 250);
    sg.addColorStop(0, sunColor);
    sg.addColorStop(.12, sunColor.replace(/[\d.]+\)$/, '.55)'));
    sg.addColorStop(1, sunColor.replace(/[\d.]+\)$/, '0)'));
    x.fillStyle=sg; x.fillRect(0,0,1024,300);
    for(let i=0;i<26;i++){
      x.fillStyle=`rgba(255,255,255,${rnd(.02,.07)})`;
      x.beginPath(); x.ellipse(rnd(0,1024), rnd(60,225), rnd(90,300), rnd(9,30), 0,0,7); x.fill();
    }
    const t = new THREE.CanvasTexture(c);
    t.mapping = THREE.EquirectangularReflectionMapping;
    t.encoding = THREE.sRGBEncoding;
    return t;
  }
};

/* ============================================================
   3. RENDERER / SCENE
   ============================================================ */
const stage = $('#stage');
const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(42, innerWidth/innerHeight, .5, 900);
camera.position.set(62, 44, 74);

const renderer = new THREE.WebGLRenderer({antialias:true, powerPreference:'high-performance'});
