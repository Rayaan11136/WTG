/* -- roads -- */
function road(x,z,w,l,plain){
  const g = new THREE.Group();
  const mat = plain ? M.roadPlain : M.road;
  const surf = new THREE.Mesh(new THREE.BoxGeometry(w,.3,l), mat.clone());
  if(l>w){ surf.material.map = mat.map.clone(); surf.material.map.repeat.set(1, l/w*1.1); }
  else { surf.material.map = mat.map.clone(); surf.material.map.rotation = Math.PI/2; surf.material.map.center.set(.5,.5); surf.material.map.repeat.set(1, w/l*1.1); }
  surf.material.map.needsUpdate = true;
  surf.material.needsUpdate = true;
  surf.position.set(x,.15,z);
  surf.receiveShadow = true;
  g.add(surf);

  const kerbW = .7, kerbH = .45;
  if(l>=w){
    for(const s of [-1,1]){
      const k = new THREE.Mesh(new THREE.BoxGeometry(kerbW,kerbH,l), M.kerb);
      k.position.set(x + s*(w/2+kerbW/2), kerbH/2, z); k.receiveShadow=true; g.add(k);
      const pave = new THREE.Mesh(new THREE.BoxGeometry(3.4,.34,l), M.concrete);
      pave.position.set(x + s*(w/2+kerbW+1.7), .17, z); pave.receiveShadow=true; g.add(pave);
    }
  } else {
    for(const s of [-1,1]){
      const k = new THREE.Mesh(new THREE.BoxGeometry(w,kerbH,kerbW), M.kerb);
