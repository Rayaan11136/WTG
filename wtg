const flows = [];
function makeFlow(curve, color, opts){
  const count = (opts && opts.count) || 30;
  const size = (opts && opts.size) || 2.0;
  const pos = new Float32Array(count*3);
  const geo = new THREE.BufferGeometry();
  geo.setAttribute('position', new THREE.BufferAttribute(pos,3));

  const mat = new THREE.PointsMaterial({
    map: glowTex, color: 0xffffff, size,
    transparent:true, opacity:1, depthWrite:false, depthTest:false,
    blending:THREE.AdditiveBlending, sizeAttenuation:true
  });
  const core = new THREE.Points(geo, mat);
  core.frustumCulled = false; core.renderOrder = 6;
  world.add(core);

  const haloMat = new THREE.PointsMaterial({
    map: glowTex, color, size: size*3.0,
    transparent:true, opacity:.6, depthWrite:false, depthTest:false,
    blending:THREE.AdditiveBlending, sizeAttenuation:true
  });
  const halo = new THREE.Points(geo, haloMat);
  halo.frustumCulled = false; halo.renderOrder = 5;
  world.add(halo);

  const tube = new THREE.Mesh(new THREE.TubeGeometry(curve, 64, .085, 6, !!(opts&&opts.closed)),
    new THREE.MeshBasicMaterial({color, transparent:true, opacity:.5, blending:THREE.AdditiveBlending, depthWrite:false}));
  tube.renderOrder = 4;
  world.add(tube);

  const prog = [];
  for(let i=0;i<count;i++) prog.push(i/count);
  return {objs:[core,halo,tube], geo, curve, prog, speed:(opts&&opts.speed)||.16, mat, haloMat, tubeMat:tube.material, color:new THREE.Color(color)};
}

function flowPath(keys, color, opts){
  const pts = keys.map(k=>NODE[k].clone());
  const curve = new THREE.CatmullRomCurve3(pts, false, 'catmullrom', .2);
  flows.push(makeFlow(curve, color, opts));
}

function clearFlows(){
  flows.forEach(f=>{
    f.objs.forEach(o=>{ world.remove(o); if(o.material) o.material.dispose(); });
    f.geo.dispose();
  });
  flows.length = 0;
}

const hubRing = (function(){
  const pts = [];
  for(let i=0;i<24;i++){
    const a = i/24*Math.PI*2;
    pts.push(new THREE.Vector3(Math.cos(a)*7.4, 8.4, Math.sin(a)*7.4));
  }
  const curve = new THREE.CatmullRomCurve3(pts, true, 'catmullrom', .5);
  return makeFlow(curve, 0x4fd3ff, {count:44, size:1.7, speed:.11, closed:true});
})();

