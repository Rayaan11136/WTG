<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>WattTheGrid — Community Grid Digital Twin</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@500;600;700&family=Barlow:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/CopyShader.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/LuminosityHighPassShader.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/GammaCorrectionShader.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/EffectComposer.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/RenderPass.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/ShaderPass.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/UnrealBloomPass.js"></script>

<style>
:root{
  --ink:#070b12;
  --panel:rgba(12,18,28,0.84);
  --panel-solid:#0c121c;
  --line:rgba(148,178,214,0.16);
  --line-strong:rgba(148,178,214,0.34);
  --fg:#e8eef7;
  --fg-dim:#8fa3bd;
  --amber:#ffb020;
  --cyan:#4fd3ff;
  --green:#3ddc8a;
  --red:#ff5a52;
  --violet:#b388ff;
  --ui:'Barlow', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  --cond:'Barlow Semi Condensed', 'Barlow', system-ui, sans-serif;
  --mono:'IBM Plex Mono', ui-monospace, Consolas, monospace;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{
  background:var(--ink);
  color:var(--fg);
  font-family:var(--ui);
  overflow:hidden;
  -webkit-font-smoothing:antialiased;
}
button{font-family:inherit;color:inherit}
#stage{position:fixed;inset:0;z-index:0}
#stage canvas{display:block}

.panel{
  position:fixed;z-index:10;
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:6px;
  backdrop-filter:blur(14px) saturate(1.2);
  -webkit-backdrop-filter:blur(14px) saturate(1.2);
  box-shadow:0 24px 60px rgba(0,0,0,.55);
}

/* ---------- masthead ---------- */
#masthead{
  top:14px;left:14px;display:flex;align-items:stretch;gap:0;padding:0;overflow:hidden;
}
.mark{
  width:46px;display:grid;place-items:center;font-size:20px;
  background:linear-gradient(160deg,#ffb020,#ff7a1a);
  color:#13202f;
}
.mast-text{padding:8px 16px 8px 14px;border-right:1px solid var(--line)}
.mast-text h1{font-family:var(--cond);font-size:19px;font-weight:700;letter-spacing:.04em;line-height:1.05}
.mast-text p{font-size:11px;color:var(--fg-dim);letter-spacing:.02em}
.mast-clock{padding:8px 16px;display:flex;flex-direction:column;justify-content:center;min-width:112px}
.mast-clock b{font-family:var(--mono);font-size:16px;font-weight:600;color:var(--cyan)}
.mast-clock span{font-size:10px;color:var(--fg-dim)}

/* ---------- top bar ---------- */
#viewbar{
  top:14px;left:50%;transform:translateX(-50%);
  display:flex;align-items:center;gap:3px;padding:5px;
}
.chip{
  background:transparent;border:1px solid transparent;border-radius:3px;
  color:var(--fg-dim);padding:6px 11px;font-size:12px;font-weight:600;
  cursor:pointer;white-space:nowrap;transition:background .15s,color .15s,border-color .15s;
}
.chip:hover{color:var(--fg);background:rgba(255,255,255,.06)}
.chip[aria-pressed="true"]{color:#13202f;background:var(--amber);border-color:var(--amber)}
.chip.time[aria-pressed="true"]{background:var(--cyan)}
.vr{width:1px;align-self:stretch;background:var(--line);margin:2px 6px}
.chip:focus-visible,.cmd:focus-visible,.crisis-btn:focus-visible{outline:2px solid var(--cyan);outline-offset:2px}

/* ---------- left console ---------- */
#console{
  top:74px;left:14px;width:325px;padding:14px;
  max-height:calc(100dvh - 92px);overflow-y:auto;overscroll-behavior:contain;
}
#console::-webkit-scrollbar{width:5px}
#console::-webkit-scrollbar-thumb{background:var(--line-strong);border-radius:3px}

.hd{
  display:flex;align-items:baseline;justify-content:space-between;
  font-family:var(--cond);font-size:13px;font-weight:700;letter-spacing:.06em;
  padding-bottom:7px;margin-bottom:10px;border-bottom:1px solid var(--line);
}
.hd i{font-style:normal;font-size:10px;font-weight:500;color:var(--fg-dim);font-family:var(--mono)}

.crisis-btn{
  width:100%;display:flex;align-items:center;gap:11px;padding:12px 13px;cursor:pointer;
  border:1px solid rgba(255,90,82,.5);border-radius:4px;
  background:linear-gradient(120deg,rgba(255,90,82,.22),rgba(255,176,32,.14));
  text-align:left;transition:border-color .15s,background .15s;
}
.crisis-btn:hover{border-color:var(--red);background:linear-gradient(120deg,rgba(255,90,82,.34),rgba(255,176,32,.2))}
.crisis-btn .glyph{
  width:30px;height:30px;flex:none;display:grid;place-items:center;border-radius:50%;
  background:rgba(255,90,82,.2);border:1px solid rgba(255,90,82,.55);font-size:15px;
}
.crisis-btn b{display:block;font-family:var(--cond);font-size:15px;letter-spacing:.03em}
.crisis-btn span{display:block;font-size:11px;color:var(--fg-dim);margin-top:1px}
.crisis-btn[data-running="true"] .glyph{animation:throb 1s infinite}
@keyframes throb{50%{background:rgba(255,90,82,.6);box-shadow:0 0 14px rgba(255,90,82,.7)}}

#crisis-track{display:none;margin-top:9px;padding:10px 11px;border:1px solid rgba(255,90,82,.32);border-radius:4px;background:rgba(255,90,82,.07)}
#crisis-track .ct-top{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
#crisis-track b{font-family:var(--cond);font-size:13.5px;letter-spacing:.03em}
#crisis-track em{font-style:normal;font-family:var(--mono);font-size:10.5px;color:var(--fg-dim)}
#crisis-track p{font-size:11.5px;color:#ffd0cc;margin-top:5px;line-height:1.45}
.bar{height:3px;background:rgba(255,255,255,.1);border-radius:2px;margin-top:9px;overflow:hidden}
.bar i{display:block;height:100%;width:0;background:var(--red);transition:width .25s linear}
.ct-steps{display:flex;gap:4px;margin-top:8px}
.ct-steps i{flex:1;height:2px;background:rgba(255,255,255,.13);border-radius:2px}
.ct-steps i.on{background:var(--amber)}

.state{margin:12px 0;padding:11px 12px;border-left:3px solid var(--green);background:rgba(61,220,138,.08);font-size:12px;line-height:1.5;color:#c8f5de;border-radius:0 4px 4px 0}
.state b{font-family:var(--cond);letter-spacing:.03em;font-size:13px;display:block;margin-bottom:2px}
.state[data-tone="warn"]{border-color:var(--amber);background:rgba(255,176,32,.09);color:#ffe2ad}
.state[data-tone="crit"]{border-color:var(--red);background:rgba(255,90,82,.1);color:#ffc8c4}
.state[data-tone="ai"]{border-color:var(--violet);background:rgba(179,136,255,.1);color:#e2d4ff}

.cmds{display:grid;gap:5px}
.cmd{
  display:flex;align-items:center;justify-content:space-between;gap:10px;
  padding:9px 11px;cursor:pointer;text-align:left;
  border:1px solid var(--line);border-radius:4px;background:rgba(255,255,255,.025);
  font-size:12.5px;font-weight:500;transition:background .15s,border-color .15s;
}
.cmd:hover{background:rgba(79,211,255,.1);border-color:var(--line-strong)}
.cmd[aria-pressed="true"]{border-color:var(--cyan);background:rgba(79,211,255,.13)}
.cmd small{font-family:var(--mono);font-size:10px;color:var(--fg-dim);white-space:nowrap}
.cmd.ai{border-color:rgba(179,136,255,.45);background:rgba(179,136,255,.12)}
.cmd.ai:hover{background:rgba(179,136,255,.2)}
.cmd.fix{border-color:rgba(61,220,138,.45);background:rgba(61,220,138,.12)}
.cmd.fix:hover{background:rgba(61,220,138,.2)}

#advice{display:none;margin-top:10px;padding:11px 12px;border:1px solid rgba(179,136,255,.35);border-radius:4px;background:rgba(88,52,160,.16);font-size:11.5px;line-height:1.55;color:#e6dbff}
#advice b{font-family:var(--cond);font-size:12.5px;letter-spacing:.04em;display:block;margin-bottom:4px;color:#d6c2ff}
#advice ul{margin:6px 0 0 14px}
#advice li{margin-bottom:3px}

/* ---------- right telemetry ---------- */
#telemetry{top:74px;right:14px;width:320px;padding:14px;max-height:calc(100dvh - 92px);overflow-y:auto}
#telemetry::-webkit-scrollbar{width:5px}
#telemetry::-webkit-scrollbar-thumb{background:var(--line-strong);border-radius:3px}
.gauges{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line);border:1px solid var(--line);border-radius:4px;overflow:hidden}
.g{background:var(--panel-solid);padding:9px 10px}
.g.wide{grid-column:span 2;display:flex;align-items:center;justify-content:space-between}
.g label{display:block;font-size:10.5px;color:var(--fg-dim);letter-spacing:.03em}
.g output{display:block;font-family:var(--mono);font-size:17px;font-weight:600;margin-top:2px;letter-spacing:-.01em}
.g em{display:block;font-style:normal;font-family:var(--mono);font-size:9.5px;color:#5c6f88;margin-top:1px}
.pill{font-family:var(--cond);font-size:12px;font-weight:700;letter-spacing:.07em;padding:4px 9px;border-radius:2px;background:rgba(61,220,138,.16);color:var(--green)}
.trace{width:100%;height:60px;display:block;margin-top:8px;border:1px solid var(--line);background:rgba(0,0,0,.35);border-radius:3px}
.trace-label{display:flex;justify-content:space-between;font-size:10px;color:var(--fg-dim);margin-top:5px;font-family:var(--mono)}

/* ---------- forecast box (60-minute lookahead) ---------- */
#forecast-box{
  margin-top:12px;padding:11px 12px;border:1px solid var(--line-strong);border-radius:4px;
  background:rgba(7,17,31,.75);
}
.fc-head{
  display:flex;align-items:center;justify-content:space-between;
  font-family:var(--cond);font-size:12px;font-weight:700;letter-spacing:.07em;
  color:var(--cyan);text-transform:uppercase;margin-bottom:8px;
}
.fc-badge{font-size:9.5px;font-family:var(--mono);color:var(--fg-dim);background:rgba(255,255,255,.07);padding:2px 6px;border-radius:2px}
.fc-grid{display:grid;grid-template-columns:1fr auto;gap:4px 10px;font-size:11px}
.fc-row{display:contents}
.fc-label{color:var(--fg-dim)}
.fc-trend{font-family:var(--mono);font-weight:600;text-align:right}
.fc-trend.up{color:#ffb020}
.fc-trend.up-high{color:#ff5a52}
.fc-trend.down{color:#4fd3ff}
.fc-trend.down-low{color:#ff5a52}
.fc-trend.stable{color:#3ddc8a}
.fc-callout{
  margin-top:9px;padding:8px 9px;border-radius:3px;font-size:11px;line-height:1.45;
  border-left:3px solid var(--amber);background:rgba(255,176,32,.1);color:#ffe4b3;
}
.fc-callout.crit{border-color:var(--red);background:rgba(255,90,82,.12);color:#ffc4bf}
.fc-callout.good{border-color:var(--green);background:rgba(61,220,138,.1);color:#c5f5dd}

/* ---------- log ---------- */
#log{left:14px;bottom:14px;width:325px;padding:11px 13px 8px}
#log-list{max-height:115px;overflow-y:auto;font-family:var(--mono);font-size:10.5px;line-height:1.6}
#log-list::-webkit-scrollbar{width:4px}
#log-list::-webkit-scrollbar-thumb{background:var(--line-strong)}
#log-list div{display:flex;gap:8px;padding:2px 0;border-bottom:1px solid rgba(255,255,255,.04)}
#log-list time{color:#5c6f88;flex:none}
.lv-ok{color:#9fdfbd}.lv-warn{color:#ffd18a}.lv-crit{color:#ff9d97}.lv-ai{color:#d8c5ff}

/* ---------- structured asset inspector ---------- */
#inspect{
  right:14px;bottom:14px;width:345px;padding:15px;display:none;
  border-color:rgba(79,211,255,.4);box-shadow:0 24px 60px rgba(0,0,0,.75), 0 0 25px rgba(79,211,255,.1);
}
#inspect .x{position:absolute;top:9px;right:11px;background:none;border:0;cursor:pointer;color:var(--fg-dim);font-size:15px;line-height:1}
#inspect h3{font-family:var(--cond);font-size:17px;letter-spacing:.03em;color:var(--cyan);padding-right:20px}
#inspect .i-badge{display:inline-block;margin:3px 0 6px;padding:2px 7px;font-size:10px;font-family:var(--mono);border-radius:2px;background:rgba(79,211,255,.15);color:var(--cyan);font-weight:600}
#inspect p{font-size:11.5px;color:#a9bcd4;line-height:1.45;margin:4px 0 10px}
#inspect table{width:100%;border-collapse:collapse;font-size:11px}
#inspect td{padding:4px 0;border-bottom:1px solid rgba(255,255,255,.06);color:var(--fg-dim)}
#inspect td+td{text-align:right;font-family:var(--mono);color:var(--fg);font-weight:500}
.i-status-dot{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:5px;vertical-align:middle}

#hint{position:fixed;z-index:30;display:none;padding:5px 10px;font-size:11px;font-weight:500;pointer-events:none;background:rgba(7,11,18,.95);border:1px solid var(--line-strong);border-radius:3px}

#sound{position:fixed;z-index:10;left:14px;bottom:0;display:none}

#boot{position:fixed;inset:0;z-index:50;display:grid;place-items:center;background:var(--ink);transition:opacity .6s}
#boot div{text-align:center}
#boot b{font-family:var(--cond);font-size:22px;letter-spacing:.08em;display:block}
#boot span{font-size:12px;color:var(--fg-dim);font-family:var(--mono)}

@media (max-width:1180px){
  #telemetry{width:275px}
  #console{width:285px}
  #log{display:none}
}
@media (max-width:900px){
  #viewbar{top:auto;bottom:10px;max-width:96vw;overflow-x:auto;justify-content:flex-start}
  #console{top:64px;left:8px;right:8px;width:auto;max-height:44dvh}
  #telemetry{top:auto;bottom:62px;left:8px;right:8px;width:auto;max-height:36dvh}
  #inspect{left:8px;right:8px;width:auto;bottom:62px}
  #masthead .mast-clock{display:none}
}
@media (prefers-reduced-motion:reduce){
  *{animation-duration:.001ms!important;transition-duration:.001ms!important}
}
</style>
</head>
<body>

<div id="stage"></div>

<div id="boot"><div><b>WattTheGrid</b><span>building community digital twin…</span></div></div>

<div class="panel" id="masthead">
  <div class="mark">⚡</div>
  <div class="mast-text">
    <h1>WattTheGrid</h1>
    <p>Riverbend microgrid · live digital twin</p>
  </div>
  <div class="mast-clock"><b id="clock">12:40:08</b><span id="clock-label">Local grid time</span></div>
</div>

<div class="panel" id="viewbar">
  <button class="chip" data-view="overview" aria-pressed="true">Overview</button>
  <button class="chip" data-view="transformer" aria-pressed="false">Transformer</button>
  <button class="chip" data-view="ev" aria-pressed="false">Charging hub</button>
  <button class="chip" data-view="homes" aria-pressed="false">Homes</button>
  <button class="chip" data-view="industry" aria-pressed="false">Industry</button>
  <span class="vr"></span>
  <button class="chip time" data-time="day" aria-pressed="true">Midday</button>
  <button class="chip time" data-time="dusk" aria-pressed="false">Dusk</button>
  <button class="chip time" data-time="night" aria-pressed="false">Night</button>
  <span class="vr"></span>
  <button class="chip" id="sound-btn" aria-pressed="true">Sound on</button>
</div>

<div class="panel" id="console">
  <div class="hd"><span>Operations</span><i>IEEE 1547</i></div>

  <button class="crisis-btn" id="crisis-btn">
    <span class="glyph">⚠</span>
    <span>
      <b>Simulate a crisis</b>
      <span id="crisis-sub">Runs a random unplanned event end to end</span>
    </span>
  </button>

  <div id="crisis-track">
    <div class="ct-top"><b id="ct-name">—</b><em id="ct-time">0s</em></div>
    <p id="ct-phase">—</p>
    <div class="bar"><i id="ct-bar"></i></div>
    <div class="ct-steps" id="ct-steps"></div>
  </div>

  <div class="state" id="state" data-tone="ok">
    <b>Grid steady</b>
    Rooftop solar and the community battery are covering demand. No constraints on any feeder.
  </div>

  <div class="hd" style="margin-top:14px"><span>Force a condition</span><i>manual</i></div>
  <div class="cmds">
    <button class="cmd" data-scenario="normal" aria-pressed="true"><span>Baseline day</span><small>58% · 50.00 Hz</small></button>
    <button class="cmd" data-scenario="ev_surge" aria-pressed="false"><span>Fleet fast charging</span><small>96% · 49.62 Hz</small></button>
    <button class="cmd" data-scenario="heatwave" aria-pressed="false"><span>Heatwave cooling peak</span><small>92% · 49.74 Hz</small></button>
    <button class="cmd" data-scenario="solar_drop" aria-pressed="false"><span>Cloud front over solar</span><small>88% · 49.80 Hz</small></button>
    <button class="cmd" data-scenario="transformer_fault" aria-pressed="false"><span>Transformer running hot</span><small>99% · 49.45 Hz</small></button>
    <button class="cmd ai" id="btn-advice"><span>Ask the dispatch model</span><small>analyse</small></button>
    <button class="cmd fix" id="btn-fix"><span>Dispatch mitigation</span><small>V2G + curtail</small></button>
  </div>

  <div id="advice"></div>
</div>

<div class="panel" id="telemetry">
  <div class="hd"><span>Telemetry</span><i>20 ms</i></div>
  <div class="gauges">
    <div class="g"><label>Feeder loading</label><output id="m-load">58.2 %</output><em id="m-load-sub">116 / 200 kVA</em></div>
    <div class="g"><label>Solar output</label><output id="m-solar">240 kW</output><em id="m-irr">940 W/m²</em></div>
    <div class="g"><label>Transformer oil</label><output id="m-temp">48.3 °C</output><em>trip at 105 °C</em></div>
    <div class="g"><label>Frequency</label><output id="m-freq">50.01 Hz</output><em>nominal 50.00</em></div>
    <div class="g"><label>Voltage</label><output id="m-volt">230.8 V</output><em>±6% band</em></div>
    <div class="g"><label>Power factor</label><output id="m-pf">0.98</output><em>lagging</em></div>
    <div class="g"><label>Battery charge</label><output id="m-soc">78 %</output><em id="m-bat">+14 kW charging</em></div>
    <div class="g"><label>Charging hub</label><output id="m-ev">35 kW</output><em id="m-ev-sub">3 vehicles</em></div>
    <div class="g wide"><div><label>Feeder condition</label><output id="m-hdr" style="font-size:13.5px">All feeders within limits</output></div><span class="pill" id="m-pill">STEADY</span></div>
  </div>

  <!-- FORECAST MODE: Next 60 Minutes Lookahead -->
  <div id="forecast-box">
    <div class="fc-head">
      <span>Next 60 Minutes</span>
      <span class="fc-badge">PREDICTIVE AI</span>
    </div>
    <div class="fc-grid">
      <div class="fc-row"><span class="fc-label">Solar</span><span class="fc-trend down" id="fc-solar">↓ 195 kW</span></div>
      <div class="fc-row"><span class="fc-label">Demand</span><span class="fc-trend up" id="fc-demand">↑ 124 kW</span></div>
      <div class="fc-row"><span class="fc-label">EV charging</span><span class="fc-trend up" id="fc-ev">↑↑ 75 kW</span></div>
      <div class="fc-row"><span class="fc-label">Battery SOC</span><span class="fc-trend down" id="fc-soc">↓ 68 %</span></div>
      <div class="fc-row"><span class="fc-label">Grid utilization</span><span class="fc-trend" id="fc-util">64.5 %</span></div>
    </div>
    <div class="fc-callout" id="fc-callout">
      Potential grid stress in approximately 35 min.
    </div>
  </div>

  <canvas class="trace" id="trace-load"></canvas>
  <div class="trace-label"><span>Loading, last 90 s</span><span id="trace-load-v">58.2%</span></div>

  <canvas class="trace" id="trace-freq"></canvas>
  <div class="trace-label"><span>Frequency deviation</span><span id="trace-freq-v">50.01 Hz</span></div>
</div>

<div class="panel" id="log">
  <div class="hd"><span>Event log</span><i id="log-count">0</i></div>
  <div id="log-list"></div>
</div>

<!-- Structured Digital Twin Asset Inspector -->
<div class="panel" id="inspect">
  <button class="x" id="inspect-x" aria-label="Close">✕</button>
  <h3 id="i-title">Transformer</h3>
  <span class="i-badge" id="i-id">TR-402-B</span>
  <p id="i-desc"></p>
  <table><tbody>
    <tr><td>Bus / Location</td><td id="i-loc">—</td></tr>
    <tr><td>Rated Capacity</td><td id="i-cap">—</td></tr>
    <tr><td>Current Load</td><td id="i-load">—</td></tr>
    <tr><td>Local Generation</td><td id="i-gen">—</td></tr>
