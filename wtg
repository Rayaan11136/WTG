let adviceBusy = false;
async function showAdvice(){
  Audio_.beep(760,.1);
  if(adviceBusy) return;
  if(!sampleFn){ fallbackAdvice(); logEvent('ai','Dispatch model produced a recommendation'); return; }

  adviceBusy = true;
  $('#btn-advice').setAttribute('aria-pressed','true');
  renderAdvice('Dispatch model · thinking', '<div style="opacity:.75">Reading telemetry…</div>');

  const situation = Crisis.running
    ? 'Live unplanned event: ' + Crisis.def.name + '. Current phase: ' + Crisis.def.phases[Math.max(0,Crisis.idx)].label
    : 'Operator forced condition: ' + (SCEN[scenarioKey] ? SCEN[scenarioKey].title : scenarioKey);

  const prompt =
`You are the dispatch optimisation model for Riverbend, a 200 kVA community microgrid in a digital twin.
The network is a ring main: one 33kV/415V transformer feeds a central hub, which feeds three sectors — 8 homes with rooftop solar and batteries, a 4-bay fast charging hub with vehicle-to-grid capability, and an industry facility with curtailable ovens and chillers. There is a 250 kWh community battery and a 250 kW wind turbine.

${situation}

Live telemetry:
- feeder loading ${S.load.toFixed(1)}% of 200 kVA
- transformer oil ${S.temp.toFixed(1)} °C (protection trips at 105)
- frequency ${S.freq.toFixed(2)} Hz, voltage ${S.volt.toFixed(1)} V, power factor ${S.pf.toFixed(2)}
- solar ${Math.round(S.solar)} kW, wind ${Math.round(S.wind)} kW
- community battery ${Math.round(S.soc)}% charged, ${Math.round(S.bat)} kW (negative is discharging)
- charging hub ${Math.round(S.ev)} kW across ${Math.round(S.evCars)} vehicles
- supply state: homes ${powered.homes?'on':'OFF'}, industry ${powered.industry?'on':'OFF'}, charging hub ${powered.ev?'on':'OFF'}

Give the control room at most three actions, ordered by urgency. Each action is one line, imperative, with a specific kW or setpoint figure, and must be something this network can actually do (curtail, throttle charging, discharge or charge the battery, request V2G export, adjust tap changer, shed load, force cooling). Then a final line beginning "Why: " of at most 25 words.
Plain text only. No markdown, no bullets, no preamble. Number the actions 1. 2. 3.`;

  const format = txt => {
    const lines = String(txt).split('\n').map(l=>l.trim()).filter(Boolean);
    const acts = lines.filter(l=>/^\d/.test(l)).map(l=>'<li>'+esc(l.replace(/^\d+[.)]\s*/,''))+'</li>');
    const why = lines.find(l=>/^why[: ]/i.test(l));
    return (acts.length ? '<ul>'+acts.join('')+'</ul>' : '<div>'+esc(txt)+'</div>') +
           (why ? '<div style="margin-top:6px;color:#c9b8f5">'+esc(why)+'</div>' : '');
  };

  try{
    const res = await sampleFn(prompt, {
      modelTier:'quick',
      cache:false,
      onText: ({text}) => {
        const b = $('#advice-body');
        if(b) b.innerHTML = format(text);
        $('#advice').querySelector('b').textContent = 'Dispatch model · ' + (Crisis.running?'live event':'current state');
      }
    });
    renderAdvice('Dispatch model · '+(Crisis.running?'live event':'current state'),
      format(res.text), 'Press “Dispatch mitigation” to carry these out.');
    logEvent('ai','Dispatch model returned a recommendation');
  }catch(e){
    if(e && e.code === 'cancelled'){}
    else {
      fallbackAdvice();
      logEvent('warn','Model unavailable ('+((e&&e.code)||'error')+') — showed the standing playbook');
    }
  }finally{
    adviceBusy = false;
    $('#btn-advice').setAttribute('aria-pressed','false');
  }
}

