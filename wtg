/* Visual reactions in the 3D world */
function updateVisualReactions(){
  const isHigh = S.load >= 75 && S.load < 90;
  const isCrit = S.load >= 90;

  // 1. Transformer warning reaction
  if(transformerParts.highlight){
    transformerParts.highlight.visible = isHigh || isCrit;
    transformerParts.highlight.material.color.setHex(isCrit ? 0xff5a52 : 0xffb020);
    transformerParts.highlight.material.opacity = isCrit ? 0.28 : 0.16;
  }

  // 2. EV Hub highlight reaction during fleet surge
  if(evHubAura){
    const evStressed = S.ev > 120 || scenarioKey === 'ev_surge';
    evHubAura.visible = evStressed;
    evHubAura.material.color.setHex(S.ev > 200 ? 0xff5a52 : 0xffb020);
    evHubAura.material.opacity = S.ev > 200 ? 0.28 : 0.15;
  }

  // 3. Industry highlight reaction during high industrial stress / heatwave
  if(industryAura){
    const indStressed = isCrit || scenarioKey === 'transformer_fault';
    industryAura.visible = indStressed;
    industryAura.material.color.setHex(isCrit ? 0xff5a52 : 0xffb020);
    industryAura.material.opacity = 0.2;
  }

  // 4. Homes highlight reaction during heatwave peak
  homesAuras.forEach(a => {
    const homesStressed = scenarioKey === 'heatwave';
    a.visible = homesStressed;
    a.material.color.setHex(0xff5a52);
    a.material.opacity = 0.22;
  });
}

function setScenario(key, silent){
  scenarioKey = key;
  const s = SCEN[key];
  if(!s) return;
  Object.assign(T, s.t);
  flowsFor(s.flow);
  condition = {tone:s.tone, pill:s.pill, headline:s.head};
  setState(s.tone, s.title, s.body);
  $$('.cmd[data-scenario]').forEach(b=>b.setAttribute('aria-pressed', String(b.dataset.scenario===key)));
  setPowered({homes:true, ev:true, industry:true});
  updateForecast();
  updateVisualReactions();

  if(!silent){
    if(s.tone==='crit'){ Audio_.alarm(); logEvent('crit', s.head); }
    else if(s.tone==='warn'){ Audio_.beep(480,.18,'triangle'); logEvent('warn', s.head); }
    else { Audio_.beep(660,.1); logEvent('ok', 'Returned to baseline conditions'); }
  }
}

function setPowered(p){
  Object.assign(powered, p);
}

function setState(tone, title, body){
  const el = $('#state');
  el.dataset.tone = tone;
  el.innerHTML = '<b>'+title+'</b>'+body;
}

/* event log */
let logN = 0;
function logEvent(level, text){
  const list = $('#log-list');
  const row = document.createElement('div');
  const now = new Date();
  const hh = String(now.getHours()).padStart(2,'0'),
        mm = String(now.getMinutes()).padStart(2,'0'),
