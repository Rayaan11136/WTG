  const blobs = near ? 3 + Math.floor(Math.random()*3) : 2;
  for(let i=0;i<blobs;i++){
    const r = rnd(1.1,2.0);
    const b = new THREE.Mesh(new THREE.IcosahedronGeometry(r,0), leafMat);
    b.position.set(rnd(-1,1), h + rnd(-.2,1.9), rnd(-1,1));
