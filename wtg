const Crisis = {
  def:null, idx:0, t:0, running:false, elapsed:0, lastId:null,
  start(){
    let c = pick(CRISES);
    let guard=0;
    while(c.id===this.lastId && guard++<8) c = pick(CRISES);
    this.lastId = c.id;
    this.def = c; this.idx = -1; this.t = 0; this.elapsed = 0; this.running = true;
    $('#crisis-btn').setAttribute('data-running','true');
    $('#crisis-btn').querySelector('b').textContent = 'Stop the simulation';
    $('#crisis-sub').textContent = c.name;
    $('#crisis-track').style.display = 'block';
    $('#ct-name').textContent = c.name;
    const steps = $('#ct-steps'); steps.innerHTML = '';
    c.phases.forEach(()=>steps.appendChild(document.createElement('i')));
    $$('.cmd[data-scenario]').forEach(b=>b.setAttribute('aria-pressed','false'));
    logEvent('warn','Crisis simulation started: '+c.name);
    Audio_.alarm();
    this.advance();
  },
  advance(){
    this.idx++;
    if(this.idx >= this.def.phases.length){ this.timeout(); return; }
    const p = this.def.phases[this.idx];
    this.t = 0;
    Object.assign(T, p.t);
    if(p.flow) flowsFor(p.flow);
    if(p.log) logEvent(p.log[0], p.log[1]);
    setState(p.tone, this.def.name, p.label);
    condition = {
      tone:p.tone,
      pill: p.tone==='crit' ? 'CRITICAL' : 'WATCH',
      headline: p.label.length>46 ? p.label.slice(0,44)+'…' : p.label
    };
    $('#ct-phase').textContent = p.label;
    Array.from($('#ct-steps').children).forEach((n,i)=>n.classList.toggle('on', i<=this.idx));
    this.fx(p.fx);
    updateForecast();
    updateVisualReactions();
  },
  fx(kind){
    switch(kind){
      case 'alarm': Audio_.alarm(); break;
      case 'sparks': burstSparks(new THREE.Vector3(17.5,9.8,-17.5)); arcFlash.position.set(17.5,9.8,-17.5); arcFlash.intensity=28; Audio_.trip(); break;
      case 'sparkline': burstSparks(new THREE.Vector3(24,10,20)); arcFlash.position.set(24,10,20); arcFlash.intensity=20; break;
      case 'smoke': faultSmokeOn = true; Audio_.alarm(); break;
      case 'fanfail': transformerParts.fans[1].userData.dead = true; Audio_.beep(300,.3,'square'); break;
      case 'flicker': window.__flicker = 2.4; break;
      case 'cloud': Audio_.beep(360,.35,'triangle'); break;
      case 'blackout':
        setPowered({homes:false, ev:false, industry:false});
        burstSparks(new THREE.Vector3(24,7,26)); arcFlash.position.set(24,7,26); arcFlash.intensity=40;
        faultSmokeOn = true; Audio_.trip(); break;
      case 'blackout_industry':
        setPowered({industry:false}); Audio_.trip(); break;
    }
  },
  tick(dt){
    if(!this.running) return;
    this.t += dt; this.elapsed += dt;
    const p = this.def.phases[this.idx];
    if(!p) return;
    $('#ct-time').textContent = Math.floor(this.elapsed)+'s';
    $('#ct-bar').style.width = clamp(this.t/p.dur*100,0,100)+'%';
    if(this.t >= p.dur) this.advance();
  },
  timeout(){
    const f = this.def.fail;
    Object.assign(T, f.t);
    if(f.flow) flowsFor(f.flow);
    logEvent(f.log[0], f.log[1]);
    setState('warn', 'Network protected itself', f.label + ' No operator action was taken in time, so the automatic scheme acted instead.');
    condition = {tone:'warn', pill:'RECOVERING', headline:'Automatic scheme operated'};
    updateForecast();
    this.stop(true);
  },
  resolve(){
    if(!this.running) return false;
    logEvent('ai','Operator mitigation dispatched during '+this.def.name);
    this.stop(true);
    return true;
  },
  stop(keepState){
    this.running = false;
    faultSmokeOn = false;
    $('#crisis-btn').setAttribute('data-running','false');
    $('#crisis-btn').querySelector('b').textContent = 'Simulate a crisis';
    $('#crisis-sub').textContent = 'Runs a random unplanned event end to end';
    $('#ct-bar').style.width = '100%';
    transformerParts.fans.forEach(f=>f.userData.dead=false);
    if(!keepState){
      setScenario('normal', true);
      $('#crisis-track').style.display='none';
    }
  }
};

